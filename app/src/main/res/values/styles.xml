<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/yellow</item>
        <item name="android:colorPrimaryDark">@color/yellow_dark</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:statusBarColor">@color/yellow</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/cream</item>
    </style>

    <!-- Dark: gold accents on near-black, like the dark mode of My Prayer -->
    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:colorPrimaryDark">@color/night</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:statusBarColor">@color/night</item>
        <item name="android:navigationBarColor">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/night</item>
    </style>
</resources>
