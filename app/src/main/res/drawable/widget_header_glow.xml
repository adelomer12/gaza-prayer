<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing border for the glass widget style: soft outer rings and a solid orange edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#33FFA726" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="1.5dp" android:left="1.5dp" android:right="1.5dp" android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="3dp" android:color="#66FFA726" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#FFFFA726" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
